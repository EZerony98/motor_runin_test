  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget {
    background: #f3f5f7;
    color: #263442;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 14px;
}
QWidget#centralwidget {
    background: #f3f5f7;
}
QFrame#testPanel, QFrame#logPanel {
    background: white;
    border: 1px solid #d8dee5;
    border-radius: 12px;
}
QFrame#machineControlPanel {
    background: #ffffff;
    border: 1px solid #d8dee5;
    border-radius: 11px;
}
QLabel#logoLabel {
    background: transparent;
    border: none;
    padding: 0;
}
QLabel#titleLabel {
    color: #202d3a;
    font-size: 28px;
    font-weight: 700;
}
QLabel#subtitleLabel {
    color: #6b7f93;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.6px;
}
QLabel#testTitle, QLabel#logTitle {
    color: #33404d;
    font-size: 16px;
    font-weight: 700;
}
QLabel#plcConnectionLabel {
    min-height: 30px;
    padding: 0 14px;
    border: 1px solid #cbd5e1;
    border-radius: 15px;
    background: #eef2f6;
    color: #8a94a3;
    font-weight: 600;
}
QLabel#plcAddressLabel {
    color: #627d98;
    font-size: 12px;
}
QPushButton {
    min-height: 34px;
    padding: 0 18px;
    border: 1px solid #b9c4ce;
    border-radius: 5px;
    background: white;
}
QPushButton:hover {
    background: #fff1f3;
    border-color: #d41432;
}
QPushButton#modeButton {
    color: #245b88;
    border-color: #9fc1dd;
    background: #edf6fd;
    font-weight: 700;
}
QPushButton#modeButton:checked {
    color: #ffffff;
    border-color: #2477b3;
    background: #2477b3;
}
QPushButton#resetButton {
    color: #8a5a00;
    border-color: #dfc27c;
    background: #fff9e8;
    font-weight: 700;
}
QPushButton#startButton {
    color: #ffffff;
    border-color: #20834f;
    background: #20834f;
    font-weight: 700;
}
QPushButton#startButton:pressed {
    background: #14683d;
}
QPushButton#emergencyButton {
    color: #b42334;
    border-color: #e09aa5;
    background: #fff3f5;
    font-weight: 700;
}
QPushButton#emergencyButton:checked {
    color: #ffffff;
    border-color: #c8102e;
    background: #c8102e;
}
QPushButton:disabled {
    color: #9aa5b1;
    border-color: #d6dce2;
    background: #eef1f4;
}
QPushButton#submitButton {
    color: white;
    border-color: #d41432;
    background: #d41432;
    font-weight: 600;
}
QPushButton#submitButton:hover {
    background: #b80f29;
}
QLineEdit {
    min-height: 36px;
    padding: 0 10px;
    border: 1px solid #b9c4ce;
    border-radius: 5px;
    background: white;
    selection-background-color: #d41432;
}
QLineEdit:focus {
    border: 2px solid #d41432;
}
QLineEdit[traySnInput="true"] {
    background: #ffffff;
    font-family: Menlo, Consolas, monospace;
    font-size: 13px;
    font-weight: 600;
}
QLineEdit#trayIdEdit {
    background: #eef2f6;
    color: #334e68;
    font-weight: 600;
}
QPlainTextEdit {
    border: 1px solid #dce2e8;
    border-radius: 6px;
    background: #fbfcfd;
    font-family: Menlo, Consolas, monospace;
    font-size: 12px;
}</string>
