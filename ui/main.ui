  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget {
    background: #f4f6f8;
    color: #1f2937;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 14px;
}
QFrame#testPanel, QFrame#logPanel {
    background: white;
    border: 1px solid #dce2e8;
    border-radius: 8px;
}
QLabel#titleLabel {
    color: #102a43;
    font-size: 24px;
    font-weight: 600;
}
QLabel#testTitle, QLabel#logTitle {
    color: #334e68;
    font-size: 16px;
    font-weight: 600;
}
QLabel#plcConnectionLabel {
    min-height: 30px;
    padding: 0 14px;
    border: 1px solid #cbd5e1;
    border-radius: 15px;
    background: #eef2f6;
    color: #8a94a3;
    font-weight: 600;
}
QLabel#plcAddressLabel {
    color: #627d98;
    font-size: 12px;
}
QPushButton {
    min-height: 34px;
    padding: 0 18px;
    border: 1px solid #b9c4ce;
    border-radius: 5px;
    background: white;
}
QPushButton:hover {
    background: #edf4fb;
}
QPushButton#submitButton {
    color: white;
    border-color: #1769aa;
    background: #1769aa;
    font-weight: 600;
}
QPushButton#submitButton:hover {
    background: #12568c;
}
QLineEdit {
    min-height: 36px;
    padding: 0 10px;
    border: 1px solid #b9c4ce;
    border-radius: 5px;
    background: white;
    selection-background-color: #1769aa;
}
QLineEdit:focus {
    border: 2px solid #1769aa;
}
QLineEdit#trayIdEdit {
    background: #eef2f6;
    color: #334e68;
    font-weight: 600;
}
QPlainTextEdit {
    border: 1px solid #dce2e8;
    border-radius: 5px;
    background: #fbfcfd;
    font-family: Menlo, Consolas, monospace;
    font-size: 12px;
}</string>
